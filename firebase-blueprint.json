{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile with token balance, verification status, and role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["user", "co-admin"]
        },
        "tokenBalance": {
          "type": "number"
        },
        "totalTokensUsed": {
          "type": "number"
        },
        "unlimitedTokens": {
          "type": "boolean"
        },
        "emailVerified": {
          "type": "boolean"
        },
        "isBlocked": {
          "type": "boolean"
        },
        "violentChatCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "role",
        "tokenBalance",
        "totalTokensUsed",
        "unlimitedTokens",
        "emailVerified",
        "isBlocked",
        "violentChatCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email and IP address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "ipAddress": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "ipAddress", "createdAt", "updatedAt"]
    },
    "ChatSessionDoc": {
      "title": "ChatSessionDoc",
      "description": "Saved user conversation history session synced to Firebase.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "messagesSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "messageCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "userName",
        "title",
        "messagesSummary",
        "messageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteConfigDoc": {
      "title": "SiteConfigDoc",
      "description": "Universal GOT Agent website configuration controlled by Admin.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "siteTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metaDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "keywords": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "universalBanner": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "festivalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultUserTokens": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authorId",
        "siteTitle",
        "metaDescription",
        "keywords",
        "universalBanner",
        "festivalName",
        "defaultUserTokens",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and token accounting."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII storage for user email and IP address."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSessionDoc" },
      "description": "User chat history sessions subcollection."
    },
    "/site_config/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfigDoc" },
      "description": "Global site configuration and SEO metadata."
    }
  }
}
